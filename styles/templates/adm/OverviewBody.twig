</div>

<div class="period-tabs">
  <button class="period-tab{% if period == 'day' %} active{% endif %}" data-period="day">{{ LNG.adm_period_day }}</button>
  <button class="period-tab{% if period == 'week' %} active{% endif %}" data-period="week">{{ LNG.adm_period_week }}</button>
