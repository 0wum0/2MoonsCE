<script>
document.addEventListener('DOMContentLoaded', function(){
  const legacy = document.querySelector('.legacy-content');
  if(legacy) legacy.classList.add('is-dashboard');
});
</script>

{# ══ HEADER ══════════════════════════════════════════════════════ #}
<div class="db-header">
  <div class="db-header-left">
    <h1 class="db-title">{{ LNG.adm_dash_title }}</h1>
    <p class="db-subtitle">{{ LNG.adm_dash_subtitle }} &mdash; {{ LNG.adm_dash_uni }} {{ uniName|default('1') }}</p>
  </div>
  <div class="db-header-right">
    <div class="db-period-tabs">
      <button class="db-period-tab{% if period == 'day' %} active{% endif %}" data-period="day">{{ LNG.adm_period_day }}</button>
      <button class="db-period-tab{% if period == 'week' %} active{% endif %}" data-period="week">{{ LNG.adm_period_week }}</button>
      <button class="db-period-tab{% if period == 'month' %} active{% endif %}" data-period="month">{{ LNG.adm_period_month }}</button>
      <button class="db-period-tab{% if period == 'year' %} active{% endif %}" data-period="year">{{ LNG.adm_period_year }}</button>
    </div>
    <div class="db-quicklinks">
      <a class="db-ql" href="admin.php?page=clearcache">&#128465; Cache</a>
      <a class="db-ql" href="admin.php?page=log">&#128203; Error-Log</a>
      <a class="db-ql" href="admin.php?page=fleets">&#128640; Flotten</a>
      <a class="db-ql" href="admin.php?page=messagelist">&#9993; Nachrichten</a>
      <a class="db-ql" href="admin.php?page=support">&#127903; Tickets</a>
      <a class="db-ql" href="admin.php?page=EditBots">&#129302; Bots</a>
    </div>
  </div>
</div>

{% if Messages is defined and Messages is not empty %}
  <div class="db-alert">
    {% for Message in Messages %}
      <div>&#9888; {{ Message }}</div>
    {% endfor %}
  </div>
{% endif %}

{# ══ SECTION 1: LIVE-ÜBERBLICK ════════════════════════════════════ #}
<div class="db-section-head"><span class="db-section-icon">&#128200;</span> Live-Überblick</div>
<div class="flipcards-grid">
  <div class="flipcard" data-color="blue">
    <div class="flipcard-inner">
      <div class="flipcard-front">
        <div class="flipcard-front-top">
          <span class="flipcard-label">{{ LNG.adm_kpi_players_online }}</span>
          <div class="flipcard-icon">&#128101;</div>
        </div>
        <div>
          <div class="flipcard-value" id="kpi-online">
            {{ report.players_online.online|default(0) }} <span class="sub">/ {{ report.players_online.total|default(0) }}</span>
          </div>
          <div class="flipcard-trend neutral">{{ LNG.adm_kpi_online_total }}</div>
        </div>
      </div>
      <div class="flipcard-back">
        <div class="flipcard-back-title">{{ LNG.adm_kpi_details }}</div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_online_15m }}</span><span class="flipcard-back-item-value">{{ report.players_online.online|default(0) }}</span></div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_total_registered }}</span><span class="flipcard-back-item-value">{{ report.players_online.total|default(0) }}</span></div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_banned }}</span><span class="flipcard-back-item-value">{{ report.banned_players.count|default(0) }}</span></div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_open_tickets }}</span><span class="flipcard-back-item-value">{{ report.open_tickets.count|default(0) }}</span></div>
      </div>
    </div>
  </div>

  <div class="flipcard" data-color="green">
    <div class="flipcard-inner">
      <div class="flipcard-front">
        <div class="flipcard-front-top">
          <span class="flipcard-label">{{ LNG.adm_kpi_registrations }}</span>
          <div class="flipcard-icon">&#128100;</div>
        </div>
        <div>
          <div class="flipcard-value" id="kpi-registrations">{{ report.registrations.count|default(0) }}</div>
          <div class="flipcard-trend neutral">{{ LNG.adm_kpi_in_period }}</div>
        </div>
      </div>
      <div class="flipcard-back">
        <div class="flipcard-back-title">{{ LNG.adm_kpi_registrations }}</div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_new_players }}</span><span class="flipcard-back-item-value">{{ report.registrations.count|default(0) }}</span></div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_period }}</span><span class="flipcard-back-item-value">{{ period|default('day') }}</span></div>
      </div>
    </div>
  </div>

  <div class="flipcard" data-color="purple">
    <div class="flipcard-inner">
      <div class="flipcard-front">
        <div class="flipcard-front-top">
          <span class="flipcard-label">{{ LNG.adm_kpi_fleets_sent }}</span>
          <div class="flipcard-icon">&#128640;</div>
        </div>
        <div>
          <div class="flipcard-value" id="kpi-fleets">
            {% if report.fleets_sent.count is defined and report.fleets_sent.count >= 0 %}{{ report.fleets_sent.count }}{% else %}<span class="na-value">n/a</span>{% endif %}
          </div>
          <div class="flipcard-trend neutral">{{ LNG.adm_kpi_in_period }}</div>
        </div>
      </div>
      <div class="flipcard-back">
        <div class="flipcard-back-title">{{ LNG.adm_kpi_fleets_info }}</div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_sent }}</span><span class="flipcard-back-item-value">{% if report.fleets_sent.count is defined and report.fleets_sent.count >= 0 %}{{ report.fleets_sent.count }}{% else %}n/a{% endif %}</span></div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_flying }}</span><span class="flipcard-back-item-value">{% if report.flying_fleets.count is defined and report.flying_fleets.count >= 0 %}{{ report.flying_fleets.count }}{% else %}n/a{% endif %}</span></div>
      </div>
    </div>
  </div>

  <div class="flipcard" data-color="cyan">
    <div class="flipcard-inner">
      <div class="flipcard-front">
        <div class="flipcard-front-top">
          <span class="flipcard-label">{{ LNG.adm_kpi_new_alliances }}</span>
          <div class="flipcard-icon">&#127942;</div>
        </div>
        <div>
          <div class="flipcard-value" id="kpi-alliances">
            {% if report.alliances_founded.count is defined and report.alliances_founded.count >= 0 %}{{ report.alliances_founded.count }}{% else %}<span class="na-value">n/a</span>{% endif %}
          </div>
          <div class="flipcard-trend neutral">{{ LNG.adm_kpi_founded }}</div>
        </div>
      </div>
      <div class="flipcard-back">
        <div class="flipcard-back-title">{{ LNG.adm_kpi_alliances_info }}</div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_new_in_period }}</span><span class="flipcard-back-item-value">{% if report.alliances_founded.count is defined and report.alliances_founded.count >= 0 %}{{ report.alliances_founded.count }}{% else %}n/a{% endif %}</span></div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_total }}</span><span class="flipcard-back-item-value">{% if report.alliances_total.count is defined and report.alliances_total.count >= 0 %}{{ report.alliances_total.count }}{% else %}n/a{% endif %}</span></div>
      </div>
    </div>
  </div>

  <div class="flipcard" data-color="red">
    <div class="flipcard-inner">
      <div class="flipcard-front">
        <div class="flipcard-front-top">
          <span class="flipcard-label">{{ LNG.adm_kpi_combats }}</span>
          <div class="flipcard-icon">&#9876;</div>
        </div>
        <div>
          <div class="flipcard-value" id="kpi-combats">
            {% if report.combats.count is defined and report.combats.count >= 0 %}{{ report.combats.count }}{% else %}<span class="na-value">n/a</span>{% endif %}
          </div>
          <div class="flipcard-trend neutral">{{ LNG.adm_kpi_in_period }}</div>
        </div>
      </div>
      <div class="flipcard-back">
        <div class="flipcard-back-title">{{ LNG.adm_kpi_combat_details }}</div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_combats }}</span><span class="flipcard-back-item-value">{% if report.combats.count is defined and report.combats.count >= 0 %}{{ report.combats.count }}{% else %}n/a{% endif %}</span></div>
      </div>
    </div>
  </div>

  <div class="flipcard" data-color="yellow">
    <div class="flipcard-inner">
      <div class="flipcard-front">
        <div class="flipcard-front-top">
          <span class="flipcard-label">{{ LNG.adm_kpi_messages }}</span>
          <div class="flipcard-icon">&#9993;</div>
        </div>
        <div>
          <div class="flipcard-value" id="kpi-messages">
            {% if report.messages.count is defined and report.messages.count >= 0 %}{{ report.messages.count }}{% else %}<span class="na-value">n/a</span>{% endif %}
          </div>
          <div class="flipcard-trend neutral">{{ LNG.adm_kpi_in_period }}</div>
        </div>
      </div>
      <div class="flipcard-back">
        <div class="flipcard-back-title">{{ LNG.adm_kpi_messages }}</div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_sent }}</span><span class="flipcard-back-item-value">{% if report.messages.count is defined and report.messages.count >= 0 %}{{ report.messages.count }}{% else %}n/a{% endif %}</span></div>
      </div>
    </div>
  </div>

  <div class="flipcard" data-color="orange">
    <div class="flipcard-inner">
      <div class="flipcard-front">
        <div class="flipcard-front-top">
          <span class="flipcard-label">{{ LNG.adm_kpi_multi_suspect }}</span>
          <div class="flipcard-icon">&#128279;</div>
        </div>
        <div>
          <div class="flipcard-value" id="kpi-multi">
            {% if report.multiaccount_flags.flagged_ips is defined %}{{ report.multiaccount_flags.flagged_ips|default(0) }}{% else %}<span class="na-value">n/a</span>{% endif %}
          </div>
          <div class="flipcard-trend neutral">{{ LNG.adm_kpi_shared_ips }}</div>
        </div>
      </div>
      <div class="flipcard-back">
        <div class="flipcard-back-title">{{ LNG.adm_kpi_multiaccount }}</div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_shared_ips }}</span><span class="flipcard-back-item-value">{{ report.multiaccount_flags.flagged_ips|default(0) }}</span></div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_affected_users }}</span><span class="flipcard-back-item-value">{{ report.multiaccount_flags.flagged_users|default(0) }}</span></div>
      </div>
    </div>
  </div>

  <div class="flipcard" data-color="pink">
    <div class="flipcard-inner">
      <div class="flipcard-front">
        <div class="flipcard-front-top">
          <span class="flipcard-label">{{ LNG.adm_kpi_planets }}</span>
          <div class="flipcard-icon">&#127759;</div>
        </div>
        <div>
          <div class="flipcard-value" id="kpi-planets">
            {% if report.planets_total.count is defined %}{{ report.planets_total.count|default(0) }}{% else %}<span class="na-value">n/a</span>{% endif %}
          </div>
          <div class="flipcard-trend neutral">{{ LNG.adm_kpi_total }}</div>
        </div>
      </div>
      <div class="flipcard-back">
        <div class="flipcard-back-title">{{ LNG.adm_kpi_planets }}</div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_total }}</span><span class="flipcard-back-item-value">{{ report.planets_total.count|default(0) }}</span></div>
      </div>
    </div>
  </div>

  <div class="flipcard" data-color="teal">
    <div class="flipcard-inner">
      <div class="flipcard-front">
        <div class="flipcard-front-top">
          <span class="flipcard-label">{{ LNG.adm_kpi_bots_active }}</span>
          <div class="flipcard-icon">&#129302;</div>
        </div>
        <div>
          <div class="flipcard-value" id="kpi-bots">{{ report.bot_activity.active_last_15m|default(0) }}</div>
          <div class="flipcard-trend neutral">{{ LNG.adm_kpi_last_15m }}</div>
        </div>
      </div>
      <div class="flipcard-back">
        <div class="flipcard-back-title">{{ LNG.adm_kpi_bot_details }}</div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_active_15m }}</span><span class="flipcard-back-item-value">{{ report.bot_activity.active_last_15m|default(0) }}</span></div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_last_tick }}</span><span class="flipcard-back-item-value">{{ report.bot_activity.last_tick_human|default('n/a') }}</span></div>
        <div class="flipcard-back-item"><span>{{ LNG.adm_kpi_log_path }}</span><span class="flipcard-back-item-value" style="font-size:11px;opacity:.8;">{{ report.bot_activity.log_path|default(LNG.adm_kpi_not_found) }}</span></div>
      </div>
    </div>
  </div>
</div>

{# ══ SECTION 2: ZEITVERLAUF ═══════════════════════════════════════ #}
<div class="db-section-head"><span class="db-section-icon">&#128202;</span> Zeitverlauf &mdash; {{ periodLabel|default('Heute') }}</div>
<div class="charts-grid">
  <div class="chart-card">
    <div class="chart-card-header">
      <div>
        <div class="chart-card-title">{{ LNG.adm_chart_activity }}</div>
        <div class="chart-card-subtitle">{{ LNG.adm_chart_activity_sub }}</div>
      </div>
    </div>
    <div class="chart-container"><canvas id="chartActivity"></canvas></div>
  </div>

  <div class="chart-card">
    <div class="chart-card-header">
      <div>
        <div class="chart-card-title">{{ LNG.adm_chart_registrations }}</div>
        <div class="chart-card-subtitle">{{ LNG.adm_chart_registrations_sub }}</div>
      </div>
    </div>
    <div class="chart-container"><canvas id="chartRegistrations"></canvas></div>
  </div>

  <div class="chart-card">
    <div class="chart-card-header">
      <div>
        <div class="chart-card-title">{{ LNG.adm_chart_fleets }}</div>
        <div class="chart-card-subtitle">{{ LNG.adm_chart_fleets_sub }}</div>
      </div>
    </div>
    <div class="chart-container"><canvas id="chartFleets"></canvas></div>
  </div>

  <div class="chart-card">
    <div class="chart-card-header">
      <div>
        <div class="chart-card-title">{{ LNG.adm_chart_combats }}</div>
        <div class="chart-card-subtitle">{{ LNG.adm_chart_combats_sub }}</div>
      </div>
    </div>
    <div class="chart-container"><canvas id="chartCombats"></canvas></div>
  </div>

  <div class="chart-card">
    <div class="chart-card-header">
      <div>
        <div class="chart-card-title">{{ LNG.adm_chart_bots }}</div>
        <div class="chart-card-subtitle">{{ LNG.adm_chart_bots_sub }}</div>
      </div>
    </div>
    <div class="chart-container"><canvas id="chartBots"></canvas></div>
  </div>
</div>

{# ══ SECTION 3: SPIELER & AKTIVITÄT ════════════════════════════ #}
<div class="db-section-head"><span class="db-section-icon">&#128101;</span> Spieler &amp; Aktivität</div>
<div class="dash-ext-grid">

  {# Last 10 Registrations #}
  <div class="dash-ext-card">
    <div class="dash-ext-title">&#128100; Letzte 10 Registrierungen</div>
    {% set regs = report.last_registrations|default([]) %}
    {% if regs is not empty %}
    <table class="dash-ext-table">
      <thead><tr><th>#</th><th>Spieler</th><th>Datum</th><th>Status</th></tr></thead>
      <tbody>
        {% for i, r in regs %}
        <tr class="{% if i < 3 %}dash-row-new{% endif %}">
          <td><span class="dash-rank-badge {% if i < 3 %}dash-rank-new{% endif %}">{{ loop.index }}</span></td>
          <td>
            <a href="admin.php?page=accountedit&id={{ r.id }}" class="dash-player-link">{{ r.username }}</a>
            {% if i < 3 %}<span class="dash-new-badge">NEU</span>{% endif %}
          </td>
          <td class="dash-muted">{{ r.register_time|date('d.m.Y H:i') }}</td>
          <td>
            {% if r.authlevel < 0 %}<span class="dash-tag dash-tag-bot">Bot</span>
            {% elseif r.authlevel > 0 %}<span class="dash-tag dash-tag-admin">Admin</span>
            {% else %}<span class="dash-tag dash-tag-ok">Spieler</span>{% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}<div class="no-data">Keine Daten</div>{% endif %}
  </div>

  {# Real vs Bot Overview #}
  <div class="dash-ext-card">
    <div class="dash-ext-title">&#129302; Spieler vs. Bots</div>
    <div class="dash-split-stat">
      <div class="dash-split-item dash-split-real">
        <div class="dash-split-num">{{ report.real_player_count|default(0) }}</div>
        <div class="dash-split-label">Echte Spieler</div>
      </div>
      <div class="dash-split-divider"></div>
      <div class="dash-split-item dash-split-bot">
        <div class="dash-split-num">{{ report.bot_player_count|default(0) }}</div>
        <div class="dash-split-label">Bot-Accounts</div>
      </div>
    </div>

    <div class="dash-ext-subtitle">&#128293; Aktivste echte Spieler (24h)</div>
    {% set topReal = report.top_online_real|default([]) %}
    {% if topReal is not empty %}
    <div class="dash-mini-list">
      {% for p in topReal %}
      <a href="admin.php?page=accountedit&id={{ p.id }}" class="dash-mini-row">
        <span class="dash-mini-rank">{{ loop.index }}</span>
        <span class="dash-mini-name">{{ p.username }}</span>
        <span class="dash-muted">{{ p.onlinetime|date('H:i') }}</span>
      </a>
      {% endfor %}
    </div>
    {% else %}<div class="no-data">Niemand online</div>{% endif %}

    <div class="dash-ext-subtitle" style="margin-top:14px;">&#129302; Aktivste Bots</div>
    {% set topBots = report.top_bots|default([]) %}
    {% if topBots is not empty %}
    <div class="dash-mini-list">
      {% for p in topBots %}
      <a href="admin.php?page=accountedit&id={{ p.id }}" class="dash-mini-row dash-mini-row-bot">
        <span class="dash-mini-rank">{{ loop.index }}</span>
        <span class="dash-mini-name">{{ p.username }}</span>
        <span class="dash-muted">{{ p.onlinetime|date('H:i') }}</span>
      </a>
      {% endfor %}
    </div>
    {% else %}<div class="no-data">Keine Bots</div>{% endif %}
  </div>

  {# Playstyle Classification #}
  <div class="dash-ext-card dash-ext-card-wide">
    <div class="dash-ext-title">&#127918; Spielertypen (Top 20 nach Punkten)</div>
    <div class="dash-playstyle-grid">

      <div class="dash-playstyle-col">
        <div class="dash-playstyle-header dash-playstyle-miner">&#9935; Miner ({{ report.playstyle.miners|default([])|length }})</div>
        {% for p in report.playstyle.miners|default([]) %}
        <a href="admin.php?page=accountedit&id={{ p.id }}" class="dash-ps-row">
          <span class="dash-ps-name">{{ p.name }}</span>
          <span class="dash-ps-pts">{{ p.total }} Pkt</span>
        </a>
        {% else %}<div class="no-data">–</div>{% endfor %}
      </div>

      <div class="dash-playstyle-col">
        <div class="dash-playstyle-header dash-playstyle-aggressor">&#9876; Aggressiv ({{ report.playstyle.aggressors|default([])|length }})</div>
        {% for p in report.playstyle.aggressors|default([]) %}
        <a href="admin.php?page=accountedit&id={{ p.id }}" class="dash-ps-row">
          <span class="dash-ps-name">{{ p.name }}</span>
          <span class="dash-ps-pts">{{ p.total }} Pkt</span>
        </a>
        {% else %}<div class="no-data">–</div>{% endfor %}
      </div>

      <div class="dash-playstyle-col">
        <div class="dash-playstyle-header dash-playstyle-neutral">&#9878; Neutral ({{ report.playstyle.neutrals|default([])|length }})</div>
        {% for p in report.playstyle.neutrals|default([]) %}
        <a href="admin.php?page=accountedit&id={{ p.id }}" class="dash-ps-row">
          <span class="dash-ps-name">{{ p.name }}</span>
          <span class="dash-ps-pts">{{ p.total }} Pkt</span>
        </a>
        {% else %}<div class="no-data">–</div>{% endfor %}
      </div>

    </div>
  </div>

</div>

{# ══ SECTION 4: GEBÄUDE & FLOTTEN ══════════════════════════════ #}
<div class="db-section-head"><span class="db-section-icon">&#127959;</span> Gebäude &amp; Flotten</div>
<div class="charts-grid">

  <div class="chart-card">
    <div class="chart-card-header">
      <div>
        <div class="chart-card-title">&#128640; Flottenaktionen (aktuell fliegend)</div>
        <div class="chart-card-subtitle">Aufschlüsselung nach Missionstyp</div>
      </div>
    </div>
    <div class="chart-container"><canvas id="chartFleetMissions"></canvas></div>
  </div>

  <div class="chart-card">
    <div class="chart-card-header">
      <div>
        <div class="chart-card-title">&#127959; Meistgebaute Gebäude</div>
        <div class="chart-card-subtitle">Gesamt-Level aller Spieler (Top 10)</div>
      </div>
    </div>
    <div class="chart-container"><canvas id="chartBuildingsMost"></canvas></div>
  </div>

</div>

<div class="dash-ext-grid">
  <div class="dash-ext-card">
    <div class="dash-ext-title">&#127959; Gebäude-Statistik: Meistgebaut</div>
    {% set bMost = report.buildings_most|default([]) %}
    {% if bMost is not empty %}
    <table class="dash-ext-table">
      <thead><tr><th>Element-ID</th><th>Gesamt-Level</th><th>Spieler</th></tr></thead>
      <tbody>
        {% for b in bMost %}
        <tr>
          <td><span class="dash-tag dash-tag-ok">ID {{ b.elementID }}</span></td>
          <td>{{ b.total_levels }}</td>
          <td class="dash-muted">{{ b.player_count }} Spieler</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}<div class="no-data">Keine Records-Daten</div>{% endif %}
  </div>

  <div class="dash-ext-card">
    <div class="dash-ext-title">&#128683; Wenigstgebaute Gebäude</div>
    {% set bLeast = report.buildings_least|default([]) %}
    {% if bLeast is not empty %}
    <table class="dash-ext-table">
      <thead><tr><th>Element-ID</th><th>Gesamt-Level</th><th>Spieler</th></tr></thead>
      <tbody>
        {% for b in bLeast %}
        <tr>
          <td><span class="dash-tag dash-tag-warn">ID {{ b.elementID }}</span></td>
          <td>{{ b.total_levels }}</td>
          <td class="dash-muted">{{ b.player_count }} Spieler</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}<div class="no-data">Keine Records-Daten</div>{% endif %}
  </div>
</div>

{# ══ SECTION 5: BOT-MONITOR ════════════════════════════════════ #}
<div class="db-section-head"><span class="db-section-icon">&#129302;</span> Bot-Monitor</div>
<div class="report-section">
  <div class="report-grid">
    <div class="report-card" style="grid-column: 1 / -1;">
      <div class="report-card-title">&#129302; {{ LNG.adm_bot_live_log }}</div>

      {% set botEvents = report.bot_activity.events|default([]) %}
      {% if botEvents is not empty %}
        <div style="display:flex;flex-direction:column;gap:10px;overflow-x:auto;">
          {% for e in botEvents %}
            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:flex-start;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:12px;min-width:0;">
              <div style="flex:0 0 auto;color:#94a3b8;font-size:12px;white-space:nowrap;">{{ e.time|default('-') }}</div>
              <div style="flex:0 0 auto;">
                <span style="display:inline-flex;align-items:center;gap:8px;">
                  <span style="font-size:12px;padding:4px 8px;border-radius:999px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);color:#e2e8f0;">
                    #{{ e.bot_id|default(0) }}
                  </span>
                  <span style="color:#e2e8f0;font-weight:600;">{{ e.bot_name|default('Bot') }}</span>
                </span>
              </div>
              <div style="flex:0 0 auto;">
                {% set st = e.status|default('info') %}
                {% if st == 'ok' %}
                  <span class="badge ok">OK</span>
                {% elseif st == 'error' %}
                  <span class="badge err">ERROR</span>
                {% else %}
                  <span class="badge">INFO</span>
                {% endif %}
              </div>
              <div style="flex:1;min-width:0;color:#e2e8f0;font-size:13px;word-break:break-word;overflow-wrap:break-word;">
                {{ e.message|default('-') }}
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="no-data">{{ LNG.adm_no_bot_events }}</div>
        <div style="margin-top:8px;color:#94a3b8;font-size:12px;">{{ LNG.adm_bot_log_expected|raw }}</div>
      {% endif %}
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

<script>
window.adminDashboardData = {
  charts: {{ chartData|json_encode|raw }},
  report: {{ report|json_encode|raw }}
};
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const data = window.adminDashboardData || {};
  const charts = data.charts || {};

  const toArray = (v) => Array.isArray(v) ? v : (v && typeof v === 'object' ? Object.values(v) : []);
  const labels = toArray(charts.labels);

  const series = {
    activity: toArray(charts.activity),
    registrations: toArray(charts.registrations),
    fleets: toArray(charts.fleets),
    combats: toArray(charts.combats),
    bots: toArray(charts.bots),
  };

  const ensureLen = (arr, len) => {
    arr = Array.isArray(arr) ? arr.slice(0, len) : [];
    while (arr.length < len) arr.push(0);
    return arr;
  };

  const L = labels.length;
  series.activity      = ensureLen(series.activity, L);
  series.registrations = ensureLen(series.registrations, L);
  series.fleets        = ensureLen(series.fleets, L);
  series.combats       = ensureLen(series.combats, L);
  series.bots          = ensureLen(series.bots, L);

  const ctxOpts = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      x: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8', font: { size: 10 } } },
      y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8', font: { size: 10 } }, beginAtZero: true }
    },
    elements: { line: { tension: 0.35, borderWidth: 2 }, point: { radius: 0, hitRadius: 10 } }
  };

  const mkChart = (id, cfg) => {
    const el = document.getElementById(id);
    if (!el) return;
    if (typeof Chart === 'undefined') return;
    try { new Chart(el, cfg); } catch(e) {}
  };

  mkChart('chartActivity', {
    type: 'line',
    data: { labels, datasets: [
      { label: {{ LNG.adm_chart_activity|json_encode }}, data: series.activity, borderColor: '#38bdf8', backgroundColor: 'rgba(56,189,248,0.12)', fill: true },
      { label: {{ LNG.adm_chart_bots|json_encode }},      data: series.bots,     borderColor: '#2dd4bf', backgroundColor: 'rgba(45,212,191,0.10)', fill: true }
    ]},
    options: Object.assign({}, ctxOpts, { plugins: { legend: { display: true, labels: { color: '#94a3b8' } } } })
  });

  mkChart('chartRegistrations', {
    type: 'bar',
    data: { labels, datasets: [
      { label: {{ LNG.adm_chart_registrations|json_encode }}, data: series.registrations, backgroundColor: '#34d399', borderRadius: 4 }
    ]},
    options: ctxOpts
  });

  mkChart('chartFleets', {
    type: 'line',
    data: { labels, datasets: [
      { label: {{ LNG.adm_qa_fleets|json_encode }}, data: series.fleets, borderColor: '#a78bfa', backgroundColor: 'rgba(167,139,250,0.12)', fill: true }
    ]},
    options: ctxOpts
  });

  mkChart('chartCombats', {
    type: 'bar',
    data: { labels, datasets: [
      { label: {{ LNG.adm_kpi_combats|json_encode }}, data: series.combats, backgroundColor: '#f87171', borderRadius: 4 }
    ]},
    options: ctxOpts
  });

  mkChart('chartBots', {
    type: 'bar',
    data: { labels, datasets: [
      { label: {{ LNG.adm_chart_bots_sub|json_encode }}, data: series.bots, backgroundColor: '#2dd4bf', borderRadius: 4 }
    ]},
    options: ctxOpts
  });

  // Fleet missions doughnut
  const fmLabels = toArray(charts.fleetMissionLabels);
  const fmData   = toArray(charts.fleetMissionData);
  const fmColors = ['#f87171','#fb923c','#fbbf24','#34d399','#38bdf8','#818cf8','#c084fc','#e879f9','#f472b6','#94a3b8','#2dd4bf','#a3e635'];
  if (fmLabels.length > 0) {
    mkChart('chartFleetMissions', {
      type: 'doughnut',
      data: { labels: fmLabels, datasets: [{ data: fmData, backgroundColor: fmColors.slice(0, fmData.length), borderWidth: 2, borderColor: '#0d1526' }] },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { display: true, position: 'right', labels: { color: '#94a3b8', font: { size: 11 }, boxWidth: 14, padding: 10 } },
          tooltip: { callbacks: { label: function(ctx) { return ' ' + ctx.label + ': ' + ctx.raw; } } }
        },
        cutout: '60%'
      }
    });
  }

  // Buildings most built bar
  const bReport = (data.report || {});
  const bMost   = Array.isArray(bReport.buildings_most) ? bReport.buildings_most : [];
  if (bMost.length > 0) {
    const bLabels = bMost.map(b => 'ID ' + b.elementID);
    const bData   = bMost.map(b => parseInt(b.total_levels) || 0);
    mkChart('chartBuildingsMost', {
      type: 'bar',
      data: { labels: bLabels, datasets: [{ label: 'Gesamt-Level', data: bData, backgroundColor: '#818cf8', borderRadius: 4 }] },
      options: Object.assign({}, ctxOpts, { indexAxis: 'y', plugins: { legend: { display: false } } })
    });
  }

  function buildPeriodUrl(period){
    const url = new URL(window.location.href);
    const params = url.searchParams;
    params.set('period', period);
    if (!params.get('page')) params.set('page', 'overview');
    url.search = params.toString();
    return url.toString();
  }

  document.querySelectorAll('.db-period-tab').forEach(btn => {
    btn.addEventListener('click', () => { window.location.href = buildPeriodUrl(btn.dataset.period); });
  });

  document.querySelectorAll('.flipcard').forEach(card => {
    card.addEventListener('click', () => card.classList.toggle('flipped'));
  });
});
</script>