<script>
document.addEventListener('DOMContentLoaded', function(){
  const legacy = document.querySelector('.legacy-content');
  if(legacy) legacy.classList.add('is-dashboard');
});
</script>

<div class="dash-header">
  <h1>{{ LNG.adm_dash_title }}</h1>
