<div class="report-section">
  <div class="report-section-title">&#128202; {{ LNG.adm_bilanz }} &mdash; {{ periodLabel|default(LNG.adm_today) }}</div>

  <div class="report-grid">
    <div class="report-card" style="grid-column: 1 / -1;">
      <div class="report-card-title">&#129302; {{ LNG.adm_bot_live_log }}</div>

      {% set botEvents = report.bot_activity.events|default([]) %}
      {% if botEvents is not empty %}
        <div style="display:flex;flex-direction:column;gap:10px;overflow-x:auto;">
          {% for e in botEvents %}
            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:flex-start;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:12px;min-width:0;">
              <div style="flex:0 0 auto;color:#94a3b8;font-size:12px;white-space:nowrap;">{{ e.time|default('-') }}</div>
              <div style="flex:0 0 auto;">
                <span style="display:inline-flex;align-items:center;gap:8px;">
                  <span style="font-size:12px;padding:4px 8px;border-radius:999px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);color:#e2e8f0;">
                    #{{ e.bot_id|default(0) }}
                  </span>
                  <span style="color:#e2e8f0;font-weight:600;">{{ e.bot_name|default('Bot') }}</span>
                </span>
              </div>
              <div style="flex:0 0 auto;">
                {% set st = e.status|default('info') %}
                {% if st == 'ok' %}
                  <span class="badge ok">OK</span>
                {% elseif st == 'error' %}
                  <span class="badge err">ERROR</span>
                {% else %}
                  <span class="badge">INFO</span>
                {% endif %}
              </div>
              <div style="flex:1;min-width:0;color:#e2e8f0;font-size:13px;word-break:break-word;overflow-wrap:break-word;">
                {{ e.message|default('-') }}
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="no-data">{{ LNG.adm_no_bot_events }}</div>
        <div style="margin-top:8px;color:#94a3b8;font-size:12px;">{{ LNG.adm_bot_log_expected|raw }}</div>
      {% endif %}
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

<script>
window.adminDashboardData = {
  charts: {{ chartData|json_encode|raw }},
  report: {{ report|json_encode|raw }}
};
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const data = window.adminDashboardData || {};
  const charts = data.charts || {};

  const toArray = (v) => Array.isArray(v) ? v : (v && typeof v === 'object' ? Object.values(v) : []);
  const labels = toArray(charts.labels);

  const series = {
    activity: toArray(charts.activity),
    registrations: toArray(charts.registrations),
    fleets: toArray(charts.fleets),
    combats: toArray(charts.combats),
    bots: toArray(charts.bots),
  };

  const ensureLen = (arr, len) => {
    arr = Array.isArray(arr) ? arr.slice(0, len) : [];
    while (arr.length < len) arr.push(0);
    return arr;
  };

  const L = labels.length;
  series.activity      = ensureLen(series.activity, L);
  series.registrations = ensureLen(series.registrations, L);
  series.fleets        = ensureLen(series.fleets, L);
  series.combats       = ensureLen(series.combats, L);
  series.bots          = ensureLen(series.bots, L);

  const ctxOpts = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      x: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8', font: { size: 10 } } },
      y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8', font: { size: 10 } }, beginAtZero: true }
    },
    elements: { line: { tension: 0.35, borderWidth: 2 }, point: { radius: 0, hitRadius: 10 } }
  };

  const mkChart = (id, cfg) => {
    const el = document.getElementById(id);
    if (!el) return;
    if (typeof Chart === 'undefined') return;
    try { new Chart(el, cfg); } catch(e) {}
  };

  mkChart('chartActivity', {
    type: 'line',
    data: { labels, datasets: [
      { label: {{ LNG.adm_chart_activity|json_encode }}, data: series.activity, borderColor: '#38bdf8', backgroundColor: 'rgba(56,189,248,0.12)', fill: true },
      { label: {{ LNG.adm_chart_bots|json_encode }},      data: series.bots,     borderColor: '#2dd4bf', backgroundColor: 'rgba(45,212,191,0.10)', fill: true }
    ]},
    options: Object.assign({}, ctxOpts, { plugins: { legend: { display: true, labels: { color: '#94a3b8' } } } })
  });

  mkChart('chartRegistrations', {
    type: 'bar',
    data: { labels, datasets: [
      { label: {{ LNG.adm_chart_registrations|json_encode }}, data: series.registrations, backgroundColor: '#34d399', borderRadius: 4 }
    ]},
    options: ctxOpts
  });

  mkChart('chartFleets', {
    type: 'line',
    data: { labels, datasets: [
      { label: {{ LNG.adm_qa_fleets|json_encode }}, data: series.fleets, borderColor: '#a78bfa', backgroundColor: 'rgba(167,139,250,0.12)', fill: true }
    ]},
    options: ctxOpts
  });

  mkChart('chartCombats', {
    type: 'bar',
    data: { labels, datasets: [
      { label: {{ LNG.adm_kpi_combats|json_encode }}, data: series.combats, backgroundColor: '#f87171', borderRadius: 4 }
    ]},
    options: ctxOpts
  });

  mkChart('chartBots', {
    type: 'bar',
    data: { labels, datasets: [
      { label: {{ LNG.adm_chart_bots_sub|json_encode }}, data: series.bots, backgroundColor: '#2dd4bf', borderRadius: 4 }
    ]},
    options: ctxOpts
  });

  function buildPeriodUrl(period){
    const url = new URL(window.location.href);
    const params = url.searchParams;
    params.set('period', period);
    if (!params.get('page')) params.set('page', 'overview');
    url.search = params.toString();
    return url.toString();
  }

  document.querySelectorAll('.period-tab').forEach(btn => {
    btn.addEventListener('click', () => { window.location.href = buildPeriodUrl(btn.dataset.period); });
  });

  document.querySelectorAll('.flipcard').forEach(card => {
    card.addEventListener('click', () => card.classList.toggle('flipped'));
  });
});
</script>