{% include "overall_header.twig" %}
<div class="legacy-content">
<div class="content-card">
  <div class="content-card-header">
    <div class="content-card-header-left">
      <div class="content-card-icon">&#128203;</div>
      <div>
        <div class="content-card-title">{{ LNG.log_cat }}</div>
        <div class="content-card-subtitle">Admin Log Kategorien</div>
      </div>
    </div>
  </div>
  <div class="content-card-body">
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
      <a href="?page=log&amp;type=planet" class="btn-secondary">&#127759; {{ LNG.log_planet }}</a>
      <a href="?page=log&amp;type=player" class="btn-secondary">&#128100; {{ LNG.log_player }}</a>
      <a href="?page=log&amp;type=settings" class="btn-secondary">&#9881; {{ LNG.log_settings }}</a>
      <a href="?page=log&amp;type=present" class="btn-secondary">&#127873; {{ LNG.log_present }}</a>
    </div>
  </div>
</div>
</div>
{% include "overall_footer.twig" %}