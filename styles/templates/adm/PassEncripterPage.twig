{% include "overall_header.twig" %}
<div class="legacy-content">
<div class="content-card">
  <div class="content-card-header">
    <div class="content-card-header-left">
      <div class="content-card-icon">&#128273;</div>
      <div>
        <div class="content-card-title">{{ et_md5_encripter|default('Passwort Generator') }}</div>
        <div class="content-card-subtitle">Passwort verschlüsseln</div>
      </div>
    </div>
  </div>
  <div class="content-card-body">
<form method="post" action="">
<table>
<tr>
	<th colspan="2">{{ et_md5_encripter }}</th>
</tr>
<tr>
	<td>{{ et_pass }}</td>
	<td><input type="text" name="md5q" size="80" value="{{ md5_md5 }}"></td>
</tr><tr>
	<td>{{ et_result }}</td>
	<td><input type="text" name="md5w" size="80" value="{{ md5_enc }}" readonly></td>
</tr><tr>
	<td colspan="2"><input type="submit" value="{{ et_encript }}"></td>
</tr>
</table>
</form>
  </div>
</div>
</div>
{% include "overall_footer.twig" %}