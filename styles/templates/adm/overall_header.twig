    <script>
    (function() {
        'use strict';

        function admNotifInit() {
            var errorBtn    = document.getElementById('notifErrorBtn');
            var errorDrop   = document.getElementById('notifErrorDropdown');
            var ticketBtn   = document.getElementById('notifTicketBtn');
            var ticketDrop  = document.getElementById('notifTicketDropdown');
            var errorBadge  = document.getElementById('notifErrorBadge');
            var ticketBadge = document.getElementById('notifTicketBadge');
            var errorBody   = document.getElementById('notifErrorBody');
            var ticketBody  = document.getElementById('notifTicketBody');

            if (!errorBtn || !ticketBtn) return;

            function positionDropdown(btn, drop) {
                var r = btn.getBoundingClientRect();
                var dropW = 300;
                var left  = r.right - dropW;
                if (left < 8) left = 8;
                drop.style.top  = (r.bottom + 6) + 'px';
                drop.style.left = left + 'px';
                drop.style.right = 'auto';
            }

            function closeAll() {
                errorDrop.classList.remove('open');
                ticketDrop.classList.remove('open');
            }

            errorBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                var isOpen = errorDrop.classList.contains('open');
                closeAll();
                if (!isOpen) {
                    positionDropdown(errorBtn, errorDrop);
                    errorDrop.classList.add('open');
                }
            });

            ticketBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                var isOpen = ticketDrop.classList.contains('open');
                closeAll();
                if (!isOpen) {
                    positionDropdown(ticketBtn, ticketDrop);
                    ticketDrop.classList.add('open');
                }
            });

            document.addEventListener('click', function() { closeAll(); });
            [errorDrop, ticketDrop].forEach(function(d) {
                d.addEventListener('click', function(e) { e.stopPropagation(); });
            });

            function updateBadge(badge, count) {
                if (count > 0) {
                    badge.textContent = count > 99 ? '99+' : count;
                    badge.style.display = '';
                } else {
                    badge.style.display = 'none';
                }
            }

            function updateBody(body, count, isError) {
                if (count > 0) {
                    if (isError) {
                        body.innerHTML = '<div class="adm-notif-item adm-notif-item-error">'
                            + '<div class="adm-notif-item-icon">&#9888;</div>'
                            + '<div class="adm-notif-item-text">'
                            + '<strong>' + count + ' Fehler-Eintr' + (count === 1 ? 'ag' : '\u00e4ge') + '</strong>'
                            + '<span>im Error-Log vorhanden</span>'
                            + '</div></div>';
                    } else {
                        body.innerHTML = '<div class="adm-notif-item adm-notif-item-ticket">'
                            + '<div class="adm-notif-item-icon">&#127903;</div>'
                            + '<div class="adm-notif-item-text">'
                            + '<strong>' + count + ' offene' + (count === 1 ? 's Ticket' : ' Tickets') + '</strong>'
                            + '<span>warten auf Antwort</span>'
                            + '</div></div>';
                    }
                } else {
                    body.innerHTML = '<div class="adm-notif-empty">'
                        + (isError ? 'Keine Fehler &#10003;' : 'Keine offenen Tickets &#10003;')
                        + '</div>';
                }
            }

            function poll() {
                var xhr = new XMLHttpRequest();
                xhr.open('GET', 'admin.php?page=adminNotifications', true);
                xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
                xhr.onload = function() {
                    if (xhr.status === 200) {
                        try {
                            var data = JSON.parse(xhr.responseText);
                            updateBadge(errorBadge,  data.errors  || 0);
                            updateBadge(ticketBadge, data.tickets || 0);
                            updateBody(errorBody,  data.errors  || 0, true);
                            updateBody(ticketBody, data.tickets || 0, false);
                        } catch(ignored) {}
                    }
                };
                xhr.send();
            }

            setInterval(poll, 60000);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', admNotifInit);
        } else {
            admNotifInit();
        }
    })();
    </script>
</head>
