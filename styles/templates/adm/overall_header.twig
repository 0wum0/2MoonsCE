                            </div>
                        </div>
                    </div>

                    {# Support Ticket Bell #}
                    <div class="adm-notif-wrap" id="notifTicketWrap">
                        <button class="adm-notif-btn" id="notifTicketBtn" aria-label="Support Tickets" title="Offene Support-Tickets">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z"/>
                            </svg>
                            {% if supportTicketCount is defined and supportTicketCount > 0 %}
                            <span class="adm-notif-badge adm-notif-badge-yellow" id="notifTicketBadge">{{ supportTicketCount > 99 ? '99+' : supportTicketCount }}</span>
                            {% else %}
                            <span class="adm-notif-badge adm-notif-badge-yellow" id="notifTicketBadge" style="display:none;">0</span>
                            {% endif %}
                        </button>
                        <div class="adm-notif-dropdown" id="notifTicketDropdown">
                            <div class="adm-notif-dropdown-head">
                                <span>&#127903; Support-Tickets</span>
                                <a href="admin.php?page=support" class="adm-notif-viewall">Alle ansehen</a>
                            </div>
                            <div class="adm-notif-dropdown-body" id="notifTicketBody">
                                {% if supportTicketCount is defined and supportTicketCount > 0 %}
                                <div class="adm-notif-item adm-notif-item-ticket">
                                    <div class="adm-notif-item-icon">&#127903;</div>
                                    <div class="adm-notif-item-text">
                                        <strong>{{ supportTicketCount }} offene{{ supportTicketCount == 1 ? 's Ticket' : ' Tickets' }}</strong>
                                        <span>warten auf Antwort</span>
                                    </div>
                                </div>
                                {% else %}
                                <div class="adm-notif-empty">Keine offenen Tickets &#10003;</div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                </div>{# /adm-notif-group #}

                <a href="game.php" class="topbar-btn">Zum Spiel</a>
                {% if currentUser is defined %}
                <div class="topbar-user">
                    <div class="topbar-user-avatar">{{ currentUser.username|default('A')|first|upper }}</div>
                    <span class="topbar-user-name">{{ currentUser.username|default('Admin') }}</span>
                </div>
                {% endif %}
            </div>
        </header>

        <main class="admin-content">
            {{ hook('admin.content.top') }}