{% extends "layout.full.twig" %}

{% block title %}{% if mode == "defense" %}{{ LNG.lm_defenses }}{% else %}{{ LNG.lm_shipshard }}{% endif %}{% endblock %}
{% block content %}

<div class="content_page">
    <div class="aerospace-wrapper">
        
        <div class="content-box header-panel">
            <h2 class="page-title">
                {% if mode == "defense" %}
                    <i class="fas fa-shield-alt"></i> {{ LNG.lm_defenses }}
                {% else %}
                    <i class="fas fa-fighter-jet"></i> {{ LNG.lm_shipshard }}
                {% endif %}
            </h2>
        </div>

        {% if BuildList %}
        <div class="content-box queue-panel">
            <div class="queue-header">
                <span><i class="fas fa-tasks"></i> {{ LNG.bd_production_queue }}</span>
                <span id="timeleft"></span>
            </div>
            <div id="bx" class="shipyard-active-timer">--:--:--</div>
            <div class="queue-body">
                <form action="game.php?page=shipyard&amp;mode={{ mode }}" method="post" class="cancel-form" data-ajax="1">
                    <input type="hidden" name="action" value="delete">
                    <select name="auftr[]" id="auftr" size="5" multiple class="queue-list">
                        <option>&nbsp;</option>
                    </select>
                    <button type="submit" class="btn-cancel">{{ LNG.bd_cancel_send }}</button>
                </form>
            </div>
        </div>
        {% endif %}

        {% if not NotBuilding %}
        <div class="status-alert">
            {{ LNG.bd_building_shipyard }}
        </div>
        {% endif %}

        <form action="game.php?page=shipyard&amp;mode={{ mode }}" method="post" data-ajax="1">
            
            <div class="ship-grid-container">
                {% for ID, Element in elementList %}
                <div class="ship-card-item"
                     data-tt-name="{{ LNG.tech[ID] }}"
                     data-tt-time="{{ Element.elementTime|time }}"
                     {% for RessID, RessAmount in Element.costResources %}
                       {% if RessID == 901 %}data-tt-metal="{{ RessAmount }}"
                       {% elseif RessID == 902 %}data-tt-crystal="{{ RessAmount }}"
                       {% elseif RessID == 903 %}data-tt-deut="{{ RessAmount }}"
                       {% elseif RessID == 921 %}data-tt-energy="{{ RessAmount }}"
                       {% endif %}
                     {% endfor %}
                     >
                    
                    <div class="ship-img-box" onclick="return Dialog.info({{ ID }})">
                        <img src="{{ dpath }}gebaeude/{{ ID }}.gif" alt="{{ LNG.tech[ID] }}" onerror="this.style.display='none'">
                        <span class="count-tag">{{ Element.available|number_format }}</span>
                    </div>

                    <div class="ship-details">
                        <div class="s-title" onclick="return Dialog.info({{ ID }})">{{ LNG.tech[ID] }}</div>
                        <div class="s-time"><i class="far fa-clock"></i> {{ Element.elementTime|time }}</div>
                        
                        <div class="s-costs">
                            {% for RessID, RessAmount in Element.costResources %}
                            <div class="cost-badge {% if Element.costOverflow[RessID] == 0 %}green{% else %}red{% endif %}">
                                <img src="{{ dpath }}images/{{ RessID }}.gif" width="12" height="12">
                                {{ RessAmount|shortly_number }}
                            </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="ship-actions">
                        {% if Element.AlreadyBuild %}
                            <div class="msg-box green">{{ LNG.bd_protection_shield_only_one }}</div>
                        {% elseif NotBuilding and Element.buyable %}
                            <div class="input-row">
                                <input type="number" name="fmenge[{{ ID }}]" id="input_{{ ID }}" value="" min="1" max="{{ Element.maxBuildable }}" tabindex="{{ loop.index }}" placeholder="0">
                                {% if Element.maxBuildable %}
                                <button type="button" class="btn-max" onclick="$('#input_{{ ID }}').val('{{ Element.maxBuildable }}')">MAX</button>
                                {% endif %}
                            </div>
                            {% if Element.maxBuildable %}
                            <div class="max-txt" onclick="$('#input_{{ ID }}').val('{{ Element.maxBuildable }}')">Max: {{ Element.maxBuildable|number_format }}</div>
                            {% endif %}
                        {% else %}
                            <div class="msg-box red">{{ LNG.bd_not_possible }}</div>
                        {% endif %}
                    </div>

                </div>
                {% endfor %}
            </div>

            {% if NotBuilding %}
            <div class="dock-footer">
                <button type="submit" class="btn-action-glow btn-build-final"><i class="fas fa-hammer"></i> {{ LNG.bd_build_ships }}</button>
            </div>
            {% endif %}

        </form>

        {% if BuildList %}
        <script type="text/javascript">
        $(function() {
            var _data  = {{ BuildList|json_encode|raw }};
            var _bd_op = {{ LNG.bd_operating|json_encode|raw }};

            if (!_data || !_data.Queue || !_data.Queue.length) return;

            var v        = new Date();
            var Shipyard = _data.Queue.slice();
            var Amount   = parseInt(Shipyard[0][1], 10);
            var hanger   = _data.b_hangar_id_plus;
            var interval;

            $('#timeleft').text(_data.pretty_time_b_hangar);
            buildList();
            tick();
            interval = window.setInterval(tick, 1000);

            function tick() {
                var n = new Date();
                var s = Math.round(Shipyard[0][2] - hanger - (n.getTime() - v.getTime()) / 1000);
                if (s <= 0) {
                    Amount -= 1;
                    if (Amount <= 0) {
                        Shipyard.shift();
                        if (Shipyard.length === 0) {
                            window.clearInterval(interval);
                            if (typeof SmAjax !== 'undefined') {
                                SmAjax.refreshPageContent();
                            } else {
                                window.location.reload();
                            }
                            return;
                        }
                        Amount = parseInt(Shipyard[0][1], 10);
                        buildList();
                    } else {
                        var opt = document.getElementById('auftr');
                        if (opt && opt.options[0]) opt.options[0].innerHTML = Amount + ' ' + Shipyard[0][0] + ' ' + _bd_op;
                    }
                    hanger = 0;
                    v = new Date();
                    s = 0;
                }
                $('#bx').text(Shipyard[0][0] + ' ' + GetRestTimeFormat(s));
            }

            function buildList() {
                var sel = document.getElementById('auftr');
                if (!sel) return;
                while (sel.options.length) sel.options[sel.options.length - 1] = null;
                for (var i = 0; i < Shipyard.length; i++) {
                    var cnt = (i === 0) ? Amount : Shipyard[i][1];
                    sel.options[i] = new Option(cnt + ' ' + Shipyard[i][0] + ' ' + _bd_op, i);
                }
            }
        });
        </script>
        {% endif %}

    </div>
</div>

{% endblock %}