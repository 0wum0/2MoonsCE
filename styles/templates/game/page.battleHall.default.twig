{% extends "layout.full.twig" %}

{% block title %}{{ LNG.lm_topkb }}{% endblock %}
{% block content %}

<div class="content_page">
<div class="aerospace-container">

    <div class="content-box header-panel">
        <h2 class="page-title"><i class="fas fa-trophy" style="color:var(--gold);"></i> {{ LNG.tkb_top }}</h2>
        <div style="font-size:11px;color:var(--dim);">{{ LNG.tkb_gratz }}</div>
    </div>

    {# ── DESKTOP TABLE ── #}
    <div class="content-box bh-desktop" style="padding:0;overflow:hidden;">
        <table class="stat-table" style="width:100%;">
            <thead>
                <tr>
                    <th style="width:40px;">#</th>
                    <th style="width:40%;">{{ LNG.tkb_owners }}</th>
                    <th style="width:25%;white-space:nowrap;">
                        <a href="game.php?page=battleHall&order=date&sort={% if sort == 'ASC' %}DESC{% else %}ASC{% endif %}"
                           style="color:{% if order == 'date' %}var(--cyan){% else %}var(--dim){% endif %};display:inline-flex;align-items:center;gap:5px;text-decoration:none;">
                            <i class="far fa-calendar-alt"></i> {{ LNG.tkb_datum }}
                            {% if order == 'date' %}<i class="fas fa-sort-{{ sort|lower }}" style="font-size:9px;"></i>{% endif %}
                        </a>
                    </th>
                    <th style="text-align:right;white-space:nowrap;">
                        <a href="game.php?page=battleHall&order=units&sort={% if sort == 'ASC' %}DESC{% else %}ASC{% endif %}"
                           style="color:{% if order == 'units' %}var(--cyan){% else %}var(--dim){% endif %};display:inline-flex;align-items:center;gap:5px;text-decoration:none;justify-content:flex-end;">
                            <i class="fas fa-crosshairs"></i> {{ LNG.tkb_units }}
                            {% if order == 'units' %}<i class="fas fa-sort-{{ sort|lower }}" style="font-size:9px;"></i>{% endif %}
                        </a>
                    </th>
                    <th style="width:50px;text-align:center;"><i class="fas fa-scroll" style="color:var(--dim);"></i></th>
                </tr>
            </thead>
            <tbody>
                {% for row in TopKBList %}
                <tr class="bh-row" onclick="window.location='game.php?page=raport&mode=battlehall&raport={{ row.rid }}'" style="cursor:pointer;">
                    <td style="text-align:center;">
                        {% if loop.index == 1 %}
                            <i class="fas fa-trophy" style="color:var(--gold);font-size:14px;" title="1. Platz"></i>
                        {% elseif loop.index == 2 %}
                            <i class="fas fa-medal" style="color:#b0bec5;font-size:14px;" title="2. Platz"></i>
                        {% elseif loop.index == 3 %}
                            <i class="fas fa-medal" style="color:#cd7f32;font-size:14px;" title="3. Platz"></i>
                        {% else %}
                            <span style="font-family:var(--font-hud);font-size:11px;color:var(--dim);">{{ loop.index }}</span>
                        {% endif %}
                    </td>

                    <td style="white-space:nowrap;">
                        <div style="display:flex;align-items:center;gap:8px;overflow:hidden;">
                            {% if row.result == "a" %}
                                <span style="color:var(--green);font-weight:600;overflow:hidden;text-overflow:ellipsis;max-width:38%;"><i class="fas fa-crown" style="font-size:10px;margin-right:3px;color:var(--gold);"></i>{{ row.attacker }}</span>
                                <span style="font-family:var(--font-hud);font-size:9px;color:var(--dim);border:1px solid var(--border);padding:1px 5px;border-radius:3px;letter-spacing:1px;flex-shrink:0;">VS</span>
                                <span style="color:var(--red);overflow:hidden;text-overflow:ellipsis;max-width:38%;">{{ row.defender }}</span>
                            {% elseif row.result == "r" %}
                                <span style="color:var(--red);overflow:hidden;text-overflow:ellipsis;max-width:38%;">{{ row.attacker }}</span>
                                <span style="font-family:var(--font-hud);font-size:9px;color:var(--dim);border:1px solid var(--border);padding:1px 5px;border-radius:3px;letter-spacing:1px;flex-shrink:0;">VS</span>
                                <span style="color:var(--green);font-weight:600;overflow:hidden;text-overflow:ellipsis;max-width:38%;"><i class="fas fa-crown" style="font-size:10px;margin-right:3px;color:var(--gold);"></i>{{ row.defender }}</span>
                            {% else %}
                                <span style="color:var(--orange);overflow:hidden;text-overflow:ellipsis;max-width:38%;">{{ row.attacker }}</span>
                                <span style="font-family:var(--font-hud);font-size:9px;color:var(--dim);border:1px solid var(--border);padding:1px 5px;border-radius:3px;letter-spacing:1px;flex-shrink:0;">VS</span>
                                <span style="color:var(--orange);overflow:hidden;text-overflow:ellipsis;max-width:38%;">{{ row.defender }}</span>
                            {% endif %}
                        </div>
                    </td>

                    <td style="color:var(--dim);font-size:11px;white-space:nowrap;">{{ row.date }}</td>

                    <td style="text-align:right;font-family:var(--font-mono);color:var(--cyan);font-size:12px;white-space:nowrap;">
                        {{ row.units|number_format }}
                    </td>

                    <td style="text-align:center;" onclick="event.stopPropagation();">
                        <a href="game.php?page=raport&amp;mode=battlehall&amp;raport={{ row.rid }}" data-fancybox class="bb-btn">
                            <i class="fas fa-scroll"></i>
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" style="text-align:center;padding:24px;color:var(--dim);font-size:12px;">
                        <i class="fas fa-inbox" style="font-size:20px;display:block;margin-bottom:8px;opacity:0.4;"></i>
                        {{ LNG.tkb_no_entries }}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# ── MOBILE CARDS ── #}
    <div class="bh-mobile">
        {% for row in TopKBList %}
        <a href="game.php?page=raport&amp;mode=battlehall&amp;raport={{ row.rid }}" data-fancybox
           style="display:block;text-decoration:none;margin-bottom:6px;">
            <div class="content-box" style="padding:12px 14px;display:flex;align-items:center;gap:12px;transition:var(--transition);border:1px solid var(--border);"
                 onmouseenter="this.style.borderColor='var(--border2)';this.style.background='rgba(0,212,255,0.04)'"
                 onmouseleave="this.style.borderColor='var(--border)';this.style.background=''">

                {# Rang #}
                <div style="width:32px;text-align:center;flex-shrink:0;">
                    {% if loop.index == 1 %}
                        <i class="fas fa-trophy" style="color:var(--gold);font-size:16px;"></i>
                    {% elseif loop.index == 2 %}
                        <i class="fas fa-medal" style="color:#b0bec5;font-size:16px;"></i>
                    {% elseif loop.index == 3 %}
                        <i class="fas fa-medal" style="color:#cd7f32;font-size:16px;"></i>
                    {% else %}
                        <span style="font-family:var(--font-hud);font-size:12px;color:var(--dim);">{{ loop.index }}</span>
                    {% endif %}
                </div>

                {# Kampf-Info #}
                <div style="flex:1;min-width:0;">
                    <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:4px;">
                        {% if row.result == "a" %}
                            <span style="color:var(--green);font-weight:600;font-size:13px;"><i class="fas fa-crown" style="font-size:9px;color:var(--gold);margin-right:2px;"></i>{{ row.attacker }}</span>
                            <span style="font-family:var(--font-hud);font-size:8px;color:var(--dim);border:1px solid var(--border);padding:1px 4px;border-radius:3px;">VS</span>
                            <span style="color:var(--red);font-size:13px;">{{ row.defender }}</span>
                        {% elseif row.result == "r" %}
                            <span style="color:var(--red);font-size:13px;">{{ row.attacker }}</span>
                            <span style="font-family:var(--font-hud);font-size:8px;color:var(--dim);border:1px solid var(--border);padding:1px 4px;border-radius:3px;">VS</span>
                            <span style="color:var(--green);font-weight:600;font-size:13px;"><i class="fas fa-crown" style="font-size:9px;color:var(--gold);margin-right:2px;"></i>{{ row.defender }}</span>
                        {% else %}
                            <span style="color:var(--orange);font-size:13px;">{{ row.attacker }}</span>
                            <span style="font-family:var(--font-hud);font-size:8px;color:var(--dim);border:1px solid var(--border);padding:1px 4px;border-radius:3px;">VS</span>
                            <span style="color:var(--orange);font-size:13px;">{{ row.defender }}</span>
                        {% endif %}
                    </div>
                    <div style="display:flex;gap:12px;font-size:11px;color:var(--dim);">
                        <span><i class="far fa-calendar-alt" style="margin-right:3px;"></i>{{ row.date }}</span>
                        <span style="color:var(--cyan);font-family:var(--font-mono);"><i class="fas fa-crosshairs" style="margin-right:3px;font-size:9px;"></i>{{ row.units|number_format }}</span>
                    </div>
                </div>

                {# Pfeil #}
                <div style="flex-shrink:0;color:var(--border2);">
                    <i class="fas fa-chevron-right" style="font-size:12px;"></i>
                </div>

            </div>
        </a>
        {% else %}
        <div class="content-box" style="text-align:center;padding:24px;color:var(--dim);font-size:12px;">
            <i class="fas fa-inbox" style="font-size:20px;display:block;margin-bottom:8px;opacity:0.4;"></i>
            {{ LNG.tkb_no_entries }}
        </div>
        {% endfor %}
    </div>

    <div style="display:flex;gap:16px;align-items:center;padding:8px 4px;">
        <span style="display:flex;align-items:center;gap:5px;font-size:11px;color:var(--dim);">
            <i class="fas fa-circle" style="color:var(--green);font-size:7px;"></i>
            <i class="fas fa-crown" style="color:var(--gold);font-size:9px;"></i>
            <span style="color:var(--green);">{{ LNG.tkb_no_entries is defined ? LNG.tkb_gewinner|striptags : 'Gewinner' }}</span>
        </span>
        <span style="display:flex;align-items:center;gap:5px;font-size:11px;color:var(--dim);">
            <i class="fas fa-circle" style="color:var(--red);font-size:7px;"></i>
            <span style="color:var(--red);">{{ LNG.tkb_verlierer|striptags }}</span>
        </span>
        <span style="display:flex;align-items:center;gap:5px;font-size:11px;color:var(--dim);">
            <i class="fas fa-circle" style="color:var(--orange);font-size:7px;"></i>
            <span style="color:var(--orange);">{{ LNG.tkb_unentschieden|striptags }}</span>
        </span>
    </div>

</div>
</div>
{% endblock %}
